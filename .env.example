# 复制成 .env 后填入真实值。.env 已在 .gitignore 里，不会被提交。

# ── 一次性：建项目 / 跑迁移 / 读取 anon key 用，用完即删 ──────────────
SUPABASE_ACCESS_TOKEN=sbp_<your-supabase-management-token>
GITHUB_TOKEN=ghp_<your-github-pat>

# ── 长期：GitHub Actions 每个交易日都要用（进 GitHub Secrets）────────
MARKME_DB_URL=postgresql://pipeline_writer:<password>@<host>:5432/postgres

# ── 长期：Vercel 环境变量（前端）──────────────────────────────────
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_<your-anon-key>
SITE_PASSWORD=<自己设，不要写进这个文件 —— 它会被提交进公开仓库>
# 管道写完之后 POST /api/revalidate?token=… 用（§10.1）。
# 必须断言响应是 200：非 200 升为 partial，否则一个 307 跳转会被当成成功。
REVALIDATE_TOKEN=<随机串>

# ── 部署：Vercel CLI / API（§11 M6）──────────────────────────────
# 这三个只在建项目与部署时用到；日常运行不需要。
# **值从你自己的 Vercel 账号取，不要往这个文件里抄** —— 它在公开仓库里，
# 而 team / project id 是账号结构的信息，不该因为「它不算 secret」就顺手公开。
VERCEL_TOKEN=<your-vercel-token>
VERCEL_ORG_ID=<your-vercel-team-id>
VERCEL_PROJECT_ID=<created-on-first-deploy>
